{
  "$schema": "ui-design-method/params/v1",
  "surface": "web-desktop",
  "use": "步骤 3 定参的起始配方。取值顺序：用户确认值 > 项目已有 token/规范 > 本包默认值；出图前把区间收敛成单值并写进执行表。",
  "viewport": {
    "design": "1440×900 CSS px，100% 缩放",
    "check": ["1280×720 短窗口", "1920×1080 大屏", "1024 宽窄桌面"],
    "theme": "项目已采用的浅/深主题各出一组"
  },
  "grid": {
    "contentMax": 1200,
    "columns": 12,
    "gutter": 24,
    "pageMargin": 32,
    "sidebar": { "collapsed": 64, "default": 240, "wide": 280 },
    "readingLineLength": "正文 60–80 字符，中文 28–40 字"
  },
  "aboveTheFold": {
    "formula": "浏览区高 = 窗口高 − 系统标题栏 − 页头 − 固定输入区 − 上下留白",
    "rule": "主操作与首批内容落在浏览区内；按预算定卡片高、换行与滚动"
  },
  "typeScale": {
    "menuButton": { "size": 15, "weight": 400, "lineHeight": 22, "tracking": 0 },
    "body": { "size": 16, "weight": 400, "lineHeight": 26, "tracking": 0 },
    "caption": { "size": 13, "weight": 400, "lineHeight": 20, "tracking": 0 },
    "sectionTitle": { "size": 24, "weight": "400–500", "lineHeight": 32, "tracking": 0 },
    "display": { "size": "36–56", "weight": "300–500", "lineHeight": "1.15–1.25", "tracking": "-0.01em 起随字号收紧" },
    "numeric": "表格与指标用 tabular-nums",
    "sample": "最长功能名、两行标题、三行正文、AI / 产品名 / 2026 / 1,238、按钮文字"
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 24, 32, 48],
    "inGroup": "8–12",
    "cardPadding": "20–24",
    "betweenSections": "24–32",
    "iconLabelGap": "8 / 10 / 12 三选一"
  },
  "radius": { "control": 10, "card": 20, "overlay": 24 },
  "border": { "width": 1, "color": "与背景同色相的中性阶，对比 1.3:1–1.6:1" },
  "shadow": {
    "levels": 3,
    "format": "offset-x offset-y blur spread color",
    "low": "0 1 2 0 rgba(ink,0.06)",
    "mid": "0 4 12 0 rgba(ink,0.08)",
    "high": "0 12 32 0 rgba(ink,0.12)"
  },
  "colorRoles": ["page", "surface", "ink", "muted", "accent", "accent-text", "border", "focus", "danger", "success", "warning", "info"],
  "neutrals": "带品牌色相的中性阶 9–11 档；纯 #fff/#000 仅用户指定时用",
  "contrast": { "bodyText": "4.5:1", "largeText": "3:1（≥24px 或 ≥19px 粗体）", "uiBoundary": "3:1" },
  "targets": {
    "clickMin": 32,
    "iconNav": 20,
    "iconInline": 18,
    "iconHero": 28,
    "strokeLight": "1.25–1.5（配 300–400 字重）",
    "strokeRegular": "1.75–2（配 500+ 字重）"
  },
  "states": ["default", "hover", "focus-visible", "active", "disabled", "loading", "empty", "error", "selected/expanded"],
  "motion": {
    "press": { "transform": "scale(0.98)", "in": 80, "out": 140 },
    "navIndicator": 200,
    "dropdown": 180,
    "panel": { "in": 240, "out": 160 },
    "easing": "进入 ease-out，退出 ease-in，位移 cubic-bezier(0.2,0,0,1)",
    "reducedMotion": "直接呈现结果态"
  },
  "breakpoints": { "narrowDesktop": 1024, "tabletHandoff": 768, "note": "低于 768 按 params-h5" },
  "darkTheme": "完整的第二套变量，同一角色映射；每个前景配实际深色背景重测对比",
  "performance": {
    "longList": "content-visibility: auto + contain-intrinsic-size；再不够才引虚拟滚动库并先报备",
    "fonts": "子集化、font-display: swap、预加载首屏字重",
    "images": "懒加载 + 宽高占位，裁切由组件负责",
    "heavyEffects": "WebGL/Canvas 写首帧成本与静态回退"
  },
  "checks": ["短窗口首屏预算", "长标题换行", "空/加载/失败态", "键盘焦点顺序", "深浅主题对比", "减少动效"]
}
